# Spark 4.0 accepts Java 17 and 21 only. openjdk@24 and plain openjdk are also installed
# on this machine and Spark rejects both, so JAVA_HOME is pinned rather than inherited.
JAVA_HOME=/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home

# Iceberg REST catalog
ASOFLINE_CATALOG_URI=http://localhost:8181
ASOFLINE_CATALOG_NAME=asofline
ASOFLINE_WAREHOUSE=s3://asofline-warehouse/

# MinIO. Development credentials only. Never point this at a real account.
ASOFLINE_S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=asofline
AWS_SECRET_ACCESS_KEY=asofline-dev-secret
AWS_REGION=us-east-1

# Kafka
ASOFLINE_KAFKA_BOOTSTRAP=localhost:9092
ASOFLINE_EVENTS_TOPIC=engagement_events
ASOFLINE_FEATURE_LOG_TOPIC=feature_logs

# Redis
ASOFLINE_REDIS_URL=redis://localhost:6379/0
